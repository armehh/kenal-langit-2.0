PORT=3000
# Optional: OpenSky API client credentials (higher rate limits)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# AirLabs flight status (free plan: 1,000 queries per month)
AIRLABS_API_KEY=
AIRLABS_DAILY_CAP=30
# Firebase web app config (public values from Firebase console > Project settings > Your apps), as one-line JSON.
# Needed for progress sync. Example: {"apiKey":"...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","appId":"1:...:web:..."}
FIREBASE_WEB_CONFIG=
